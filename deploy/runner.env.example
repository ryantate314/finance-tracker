# Paste into Portainer stack env vars for runner-stack.yml.

REPO_URL=https://github.com/ryantate314/transactatrack

# GitHub PAT (classic, scope: repo) OR fine-grained token with
# Actions: Read/Write on this repo. Treat as a secret.
ACCESS_TOKEN=ghp_REPLACE_ME

# Friendly name shown in GitHub Settings → Actions → Runners.
RUNNER_NAME=home-server
