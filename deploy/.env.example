# Copy into Portainer stack environment variables (or .env when running locally).

# Use host.docker.internal to reach Postgres on the Docker host.
POSTGRES_CONNECTION=Host=host.docker.internal;Port=5432;Database=transactatrack;Username=postgres;Password=CHANGEME

# Ollama lives on the workstation with the GPU.
OLLAMA_BASE_URL=http://10.0.20.20:11434
OLLAMA_MODEL=qwen3:14b

# Host port for the UI (nginx). API is internal-only.
WEB_HOST_PORT=5080
